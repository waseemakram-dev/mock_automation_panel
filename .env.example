# OpenAI API Credentials
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# Apify API Credentials (Google Maps Scraper)
NEXT_PUBLIC_APIFY_API_KEY=your_apify_api_key_here

# WhatsApp / Green API Credentials
NEXT_PUBLIC_GREEN_API_INSTANCE_ID=your_instance_id
NEXT_PUBLIC_GREEN_API_TOKEN=your_api_token

# Email / Resend Credentials
RESEND_API_KEY=your_resend_api_key

# Firebase Credentials
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key\n-----END PRIVATE KEY-----\n"
